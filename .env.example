# --- Auth (default: subscription OAuth token) -------------------------------
# Generate on the host with `just token` (runs `claude setup-token`), then paste
# the value here. Valid ~1 year, works with your Pro/Max subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional fallback: an Anthropic Console API key (pay-as-you-go). Leave blank
# if you're using the OAuth token above.
ANTHROPIC_API_KEY=

# --- Project to work on -----------------------------------------------------
# Absolute host path mounted as /workspace inside the container. Edits there
# are written straight back to this directory on your Mac.
PROJECT_DIR=/Users/andy.eschbacher/git/andy-esch/your-project
